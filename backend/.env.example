# Server Configuration
PORT=5000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/digital_kerala_db
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# Security & Authentication
JWT_SECRET=digital_kerala_jwt_secret_key_change_in_production_2026
CLIENT_URL=http://localhost:5173
# Add the deployed React origin here, or use FRONTEND_URL for a separate value.
FRONTEND_URL=

# Email Service (Nodemailer SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
RECIPIENT_EMAIL=admin@digitalkerala.org

# Default Admin Credentials (Auto-seeded on boot if not existing)
ADMIN_NAME=Digital Kerala Admin
ADMIN_EMAIL=admin@digitalkerala.org
ADMIN_PASSWORD=AdminPassword123!
